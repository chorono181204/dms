// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. Tổ chức & Người dùng
model Department {
  id                Int               @id @default(autoincrement())
  name              String
  code              String            @unique // Mã khoa/phòng (KHS, KKB...)
  users             User[]
  templates         Template[]
  documents         Document[]
  categories        Category[]
  signatures        Signature[]
  documentHistories DocumentHistory[]

  createdBy String? // Username or Name
  updatedBy String?

  // Security Flag
  isSupervisory       Boolean              @default(false)
  tasks               Task[]
  documentPermissions DocumentPermission[]
  templatePermissions TemplatePermission[]
}

model User {
  id              Int         @id @default(autoincrement())
  name            String? // fullName
  username        String      @unique
  password        String
  role            String      @default("USER") // USER, MANAGER, ADMIN
  isEmailVerified Boolean     @default(true)
  phone           String?
  position        String? // Chức vụ (Trưởng khoa, Nhân viên...)
  isChief         Boolean     @default(false) // KTV Trưởng
  // Quan hệ tổ chức
  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id])

  // Thông tin chữ ký
  signatureImage String? // URL ảnh chữ ký mặc định
  digitalCert    String? // Serial number của chứng thư số

  // Quan hệ văn bản - REMOVED RELATIONS TO DECOUPLE
  permissions         DocumentPermission[]
  templatePermissions TemplatePermission[]

  // Auth
  // Token relation removed

  // Audit
  createdBy         String?
  updatedBy         String?
  signatureRequests SignatureRequest[]

  // Task Management Relations
  assignedTasks Task[]        @relation("TaskAssignees")
  createdTasks  Task[]        @relation("TaskAssigner")
  approvedTasks Task[]        @relation("TaskApprover")
  taskComments  TaskComment[]

  notifications Notification[]
  conversations Participant[]
  messages      Message[]
}

// 2. Mẫu văn bản
model Template {
  id      Int    @id @default(autoincrement())
  name    String
  content String // HTML/JSON content

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Data Isolation: Mẫu thuộc phòng ban nào
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  isActive Boolean @default(true)

  // Phân quyền nâng cao
  visibility  String               @default("PRIVATE") // PRIVATE, DEPARTMENT, PUBLIC
  accessLevel String               @default("VIEW") // VIEW, EDIT
  permissions TemplatePermission[]

  createdBy String?
  updatedBy String?
}

model TemplatePermission {
  id Int @id @default(autoincrement())

  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Quyền: "VIEW", "EDIT", "DOWNLOAD"
  permission String

  createdBy String?
  updatedBy String?

  @@unique([templateId, userId, departmentId, permission])
}

// 2.1 Danh mục tài liệu
model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean @default(true)

  // Hierarchical structure (self-referencing for folder nesting)
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryHierarchy")

  // Optimization fields
  path  String? // Full path for breadcrumbs (e.g., "ISO/Quality/2024")
  level Int     @default(0) // Depth level (0 = root)
  order Int     @default(0) // Custom sort order within same parent

  // Direct 1:N Relation
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  isGlobal Boolean @default(false)

  documents Document[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  createdBy String?
  updatedBy String?
  templates Template[]
}

// 3. Văn bản & Dữ liệu
model Document {
  id      Int     @id @default(autoincrement())
  code    String? @unique // Số văn bản / Mã hồ sơ
  title   String
  content String // Nội dung HTML/JSON

  status String @default("DRAFT") // DRAFT, PENDING, APPROVED, SIGNED, REJECTED, ARCHIVED

  // Data Isolation: Văn bản thuộc về phòng ban nào
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Người tạo - CHANGED TO STRING
  createdBy     String // Username
  createdByName String? // Full Name snapshot
  updatedBy     String?
  updatedByName String? // Full Name snapshot

  // Phân quyền nâng cao: Google Docs Style
  visibility  String @default("PRIVATE") // PRIVATE (Chỉ tôi), DEPARTMENT (Khoa/Phòng), PUBLIC (Cả bệnh viện)
  accessLevel String @default("VIEW") // VIEW (Chỉ xem), EDIT (Được sửa) - Áp dụng khi Public/Department

  // Phân quyền chi tiết: Ai được làm gì với văn bản này?
  permissions DocumentPermission[]

  // Dữ liệu ký
  signatures Signature[]
  history    DocumentHistory[]

  // Version control
  currentVersion Int               @default(1)
  versions       DocumentVersion[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  signatureRequests SignatureRequest[]

  effectiveDate  DateTime?
  expirationDate DateTime?
  deletedAt      DateTime?

  attachments DocumentAttachment[]
  isReference Boolean              @default(false)
}

// 3.1 Document Version Control
model DocumentVersion {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int
  filePath      String
  fileSize      Int
  changeNote    String?

  createdBy     String
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// Bảng phân quyền (Thay thế Workflow)
// Still needs User link for login access
model DocumentPermission {
  id Int @id @default(autoincrement())

  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Quyền: "VIEW", "EDIT", "SIGN", "APPROVE", "DOWNLOAD"
  permission String

  createdBy String?
  updatedBy String?

  @@unique([documentId, userId, departmentId, permission])
}

// 4. Chữ ký & Lịch sử
model Signature {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // CHANGED TO STRING
  signedBy String // Username/Name of signer

  step Int // Ký ở bước nào (hoặc thứ tự ký)
  type String // IMAGE, DIGITAL, OTP

  // Metadata
  comment        String?
  hash           String?
  signatureValue String?

  // Audit
  createdBy String?
  updatedBy String?

  // Data Isolation
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
}

model DocumentHistory {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // CHANGED TO STRING
  createdBy     String? // Username of actor
  createdByName String? // Full Name snapshot

  action      String // CREATED, UPDATED, SUBMITTED...
  description String?

  updatedBy String?

  // Data Isolation
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
}

// 5. Quy trình trình ký
model SignatureRequest {
  id Int @id @default(autoincrement())

  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  status String @default("PENDING") // PENDING, SIGNED, REJECTED
  step   Int    @default(1) // Signing order step

  requestedAt DateTime  @default(now())
  signedAt    DateTime?
  note        String? // Ghi chú từ người gửi hoặc phản hồi

  @@unique([documentId, userId])
}

model DocumentAttachment {
  id         Int      @id @default(autoincrement())
  documentId Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  filePath String
  fileName String
  fileSize Int
  fileType String? // MIME type

  createdBy String?
  createdAt DateTime @default(now())

  @@index([documentId])
}

// 6. Messaging System (Real-time Chat)
model Conversation {
  id       Int     @id @default(autoincrement())
  type     String  @default("DIRECT") // DIRECT (1-1) or GROUP
  name     String? // Tên nhóm
  leaderId Int? // ID người tạo/trưởng nhóm

  messages     Message[]
  participants Participant[]

  // Participants (for DIRECT chat compatibility)
  user1Id Int?
  user2Id Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user1Id, user2Id])
}

model Participant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User    @relation(fields: [senderId], references: [id])
  text     String?
  type     String  @default("text") // text, file, image

  attachments MessageAttachment[]

  createdAt DateTime  @default(now())
  readAt    DateTime?
}

model MessageAttachment {
  id        Int     @id @default(autoincrement())
  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filePath String
  fileName String
  fileSize Int
  fileType String?

  createdAt DateTime @default(now())
}

// 7. Task Management (Kanban)
// 7. Task Management (Kanban)

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  status      String  @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Assignee (User who does the task)
  // Assignee (User who does the task) - Many to Many
  assignees User[] @relation("TaskAssignees")

  // Assigner (User who created/assigned the task)
  assignerId Int
  assigner   User @relation("TaskAssigner", fields: [assignerId], references: [id])

  // Approver (Person who reviews/approves the task)
  approverId Int?
  approver   User? @relation("TaskApprover", fields: [approverId], references: [id])

  // Department scope (Optional: if assigned to a whole department or for filtering)
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  dueDate     DateTime?
  completedAt DateTime?

  attachments TaskAttachment[]
  comments    TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskComment {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  content String?
  type    String  @default("COMMENT") // COMMENT, RESULT

  attachments TaskAttachment[]

  createdAt DateTime @default(now())
}

model TaskAttachment {
  id     Int  @id @default(autoincrement())
  taskId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  taskCommentId Int?
  taskComment   TaskComment? @relation(fields: [taskCommentId], references: [id], onDelete: Cascade)

  filePath String
  fileName String
  fileSize Int
  fileType String?

  uploadedBy String // Username
  createdAt  DateTime @default(now())
}

// 8. Notification System
model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String
  type    String  @default("SYSTEM") // SYSTEM, TASK, DOCUMENT
  link    String? // Action URL (e.g., /tasks?taskId=1)

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
